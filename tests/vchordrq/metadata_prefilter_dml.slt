t

statement ok
SET vchordrq.metadata_block_prune = off;

statement ok
DROP FUNCTION metadata_prefilter_dml_ids(text, text, text);

statement ok
DROP FUNCTION metadata_prefilter_dml_uses_index(text);

statement ok
DROP TABLE metadata_prefilter_dml_items;
