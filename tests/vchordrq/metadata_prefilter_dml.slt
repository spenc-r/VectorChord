----
t

# NULL metadata is not resident in the index tail.  It must fall back safely,
# and then stop matching after the row is updated to a non-NULL tenant hash.
statement ok
INSERT INTO metadata_prefilter_dml_items VALUES
  (1004, NULL, 2, 0, 3, 5, '[0.003,0,0]'::vector);

query B
SELECT metadata_prefilter_dml_ids(
  'off',
  '',
  $$tenant_hash IS NULL AND state_code = 2 AND deletion_marker = 0$$
) = metadata_prefilter_dml_ids(
  'reject_only',
  '',
  $$tenant_hash IS NULL AND state_code = 2 AND deletion_marker = 0$$
);
----
t

query B
SELECT 1004 = ANY(metadata_prefilter_dml_ids(
  'reject_only',
  '',
  $$tenant_hash IS NULL AND state_code = 2 AND deletion_marker = 0$$
));
----
t

statement ok
UPDATE metadata_prefilter_dml_items
SET tenant_hash = hashtextextended('feed-1', 0)
WHERE id = 1004;

query B
SELECT metadata_prefilter_dml_ids(
  'off',
  '',
  $$tenant_hash IS NULL AND state_code = 2 AND deletion_marker = 0$$
) = metadata_prefilter_dml_ids(
  'reject_only',
  '',
  $$tenant_hash IS NULL AND state_code = 2 AND deletion_marker = 0$$
);
----
t

query B
SELECT 1004 = ANY(metadata_prefilter_dml_ids(
  'reject_only',
  '',
  $$tenant_hash IS NULL AND state_code = 2 AND deletion_marker = 0$$
));
----
f

# Exact covered metadata may skip the AM-side heap prefilter.  Keep it equal
# to off-mode after the update churn above.
query B
SELECT metadata_prefilter_dml_ids(
  'off',
  'state_code,deletion_marker,flag_bits',
  $$state_code = 2 AND deletion_marker = 0 AND (flag_bits & 3) = 3$$
) = metadata_prefilter_dml_ids(
  'covered_skip_heap',
  'state_code,deletion_marker,flag_bits',
  $$state_code = 2 AND deletion_marker = 0 AND (flag_bits & 3) = 3$$
);
----
t

# Delete matching appendable tuples, then vacuum so bulkdelete nulls their
# index payloads.  Both reject_only and block-prune-on reject_only must remain
# equal to off-mode.
statement ok
DELETE FROM metadata_prefilter_dml_items
WHERE id IN (1002, 1003, 1004);

statement ok
VACUUM metadata_prefilter_dml_items;

query B
SELECT metadata_prefilter_dml_ids(
  'off',
  '',
  $$tenant_hash = hashtextextended('feed-1', 0)
    AND state_code = 2
    AND deletion_marker = 0
    AND (flag_bits & 3) = 3
    AND geo_token = ANY(ARRAY[4,5,6]::bigint[])$$
) = metadata_prefilter_dml_ids(
  'reject_only',
  '',
  $$tenant_hash = hashtextextended('feed-1', 0)
    AND state_code = 2
    AND deletion_marker = 0
    AND (flag_bits & 3) = 3
    AND geo_token = ANY(ARRAY[4,5,6]::bigint[])$$
);
----
t

query B
SELECT NOT (1002 = ANY(metadata_prefilter_dml_ids(
  'reject_only',
  '',
  $$tenant_hash = hashtextextended('feed-1', 0)
    AND state_code = 2
    AND deletion_marker = 0
    AND (flag_bits & 3) = 3
    AND geo_token = ANY(ARRAY[4,5,6]::bigint[])$$
)));
----
t

statement ok
SET vchordrq.metadata_block_prune = on;

query B
SELECT metadata_prefilter_dml_ids(
  'off',
  '',
  $$tenant_hash = hashtextextended('feed-1', 0)
    AND state_code = 2
    AND deletion_marker = 0
