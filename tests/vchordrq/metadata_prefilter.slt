# End-to-end coverage for vchordrq wide-INCLUDE metadata prefilter.

statement ok
SET enable_seqscan = off;

statement ok
SET max_parallel_workers_per_gather = 0;

statement ok
SET vchordrq.probes = '';

statement ok
SET vchordrq.prefilter = on;

statement ok
CREATE TABLE metadata_prefilter_items (
  id                       int PRIMARY KEY,
  tenant_hash              bigint,
  state_code               bigint,
  visibility_code          bigint,
  deletion_marker          bigint,
  flag_bits                bigint,
  geo_token                bigint,
  time_bucket              bigint,
  non_meta                 bigint,
  v                        vector(3) NOT NULL
);

statement ok
INSERT INTO metadata_prefilter_items
SELECT i,
       CASE WHEN i % 37 = 0
            THEN NULL
            ELSE hashtextextended('feed-' || (i % 5)::text, 0)
       END,
       (i % 3)::bigint,
       (i % 2)::bigint,
       ((i % 17) = 0)::int::bigint,
       CASE WHEN i % 4 = 0 THEN 3 ELSE 1 END,
       (i % 10)::bigint,
       (i / 10)::bigint,
       (i % 11)::bigint,
       ARRAY[
         (i % 97) / 97.0,
         (i % 89) / 89.0,
         (i % 83) / 83.0
       ]::real[]::vector
FROM generate_series(1, 200) i;

statement ok
CREATE INDEX metadata_prefilter_all_idx
ON metadata_prefilter_items
USING vchordrq (v vector_l2_ops)
INCLUDE (
  tenant_hash,
  state_code,
  visibility_code,
  deletion_marker,
  flag_bits,
  geo_token,
  time_bucket,
  non_meta
)
WITH (options = $$
residual_quantization = false
rerank_in_table = false
[metadata]
columns = [
  { name = "tenant_hash", ops = ["eq", "in"], exact = false },
  { name = "state_code", ops = ["eq", "in"], exact = true },
  { name = "visibility_code", ops = ["eq"], exact = true },
  { name = "deletion_marker", ops = ["eq"], exact = true },
  { name = "flag_bits", ops = ["eq", "bitmask_contains"], exact = true },
  { name = "geo_token", ops = ["eq", "in", "range"], exact = false },
  { name = "time_bucket", ops = ["range"], exact = false },
]
[build.internal]
lists = []
$$);

statement ok
CREATE INDEX metadata_prefilter_feed_idx
ON metadata_prefilter_items (tenant_hash);

statement ok
CREATE INDEX metadata_prefilter_status_idx
ON metadata_prefilter_items (state_code);

statement ok
CREATE INDEX metadata_prefilter_deleted_idx
ON metadata_prefilter_items (deletion_marker);

statement ok
CREATE TABLE metadata_prefilter_subset AS
SELECT * FROM metadata_prefilter_items;

statement ok
CREATE INDEX metadata_prefilter_subset_idx
ON metadata_prefilter_subset
USING vchordrq (v vector_l2_ops)
INCLUDE (tenant_hash, state_code)
WITH (options = $$
residual_quantization = false
rerank_in_table = false
[metadata]
columns = [
  { name = "tenant_hash", ops = ["eq", "in"], exact = false },
  { name = "state_code", ops = ["eq", "in"], exact = true },
]
[build.internal]
lists = []
$$);

statement ok
CREATE TABLE metadata_prefilter_plain AS
SELECT * FROM metadata_prefilter_items;

statement ok
CREATE INDEX metadata_prefilter_plain_idx
ON metadata_prefilter_plain
USING vchordrq (v vector_l2_ops)
WITH (options = $$
residual_quantization = false
rerank_in_table = false
[build.internal]
lists = []
$$);

statement ok
ANALYZE metadata_prefilter_items;

statement ok
ANALYZE metadata_prefilter_subset;

statement ok
ANALYZE metadata_prefilter_plain;

statement ok
CREATE OR REPLACE FUNCTION metadata_prefilter_ids_from(
  rel regclass,
  mode text,
  active text,
  where_sql text
) RETURNS int[]
  LANGUAGE plpgsql AS $$
DECLARE
  result int[];
BEGIN
  PERFORM set_config('vchordrq.prefilter', 'on', true);
  PERFORM set_config('vchordrq.metadata_prefilter', mode, true);
  PERFORM set_config('vchordrq.metadata_active_columns', active, true);
  EXECUTE format(
    'SELECT ARRAY(
       SELECT id FROM %s
       WHERE %s
       ORDER BY v <-> ''[0.25,0.25,0.25]''::vector
       LIMIT 20
     )',
    rel,
    where_sql
  )
  INTO result;
  RETURN result;
END $$;

query B
SELECT metadata_prefilter_ids_from(
  'metadata_prefilter_items',
  'off',
  '',
  $$tenant_hash = hashtextextended('feed-2', 0)
    AND state_code = 1
    AND deletion_marker = 0$$
) = metadata_prefilter_ids_from(
  'metadata_prefilter_items',
  'reject_only',
  '',
  $$tenant_hash = hashtextextended('feed-2', 0)
    AND state_code = 1
    AND deletion_marker = 0$$
);
----
t

query B
SELECT metadata_prefilter_ids_from(
  'metadata_prefilter_items',
  'off',
  '',
  $$non_meta = 7$$
) = metadata_prefilter_ids_from(
  'metadata_prefilter_items',
  'reject_only',
  '',
  $$non_meta = 7$$
);
----
t

query B
SELECT metadata_prefilter_ids_from(
  'metadata_prefilter_items',
  'off',
  '',
  $$(flag_bits & 3) = 3 AND state_code = 1$$
) = metadata_prefilter_ids_from(
  'metadata_prefilter_items',
  'reject_only',
  '',
  $$(flag_bits & 3) = 3 AND state_code = 1$$
);
----
t

query B
SELECT metadata_prefilter_ids_from(
  'metadata_prefilter_items',
  'off',
  '',
  $$time_bucket >= 5 AND time_bucket < 12$$
) = metadata_prefilter_ids_from(
  'metadata_prefilter_items',
  'reject_only',
  '',
  $$time_bucket >= 5 AND time_bucket < 12$$
);
----
t

query B
SELECT coalesce(array_length(metadata_prefilter_ids_from(
  'metadata_prefilter_items',
  'reject_only',
  '',
  $$tenant_hash = -1$$
), 1), 0) = 0;
----
t

query B
SELECT metadata_prefilter_ids_from(
  'metadata_prefilter_items',
  'off',
  '',
  $$tenant_hash IS NULL$$
) = metadata_prefilter_ids_from(
  'metadata_prefilter_items',
  'reject_only',
  '',
  $$tenant_hash IS NULL$$
);
----
t

query B
SELECT metadata_prefilter_ids_from(
  'metadata_prefilter_subset',
  'off',
  '',
  $$geo_token = 3 AND state_code = 1$$
) = metadata_prefilter_ids_from(
  'metadata_prefilter_subset',
  'reject_only',
  '',
  $$geo_token = 3 AND state_code = 1$$
);
----
t

query B
SELECT metadata_prefilter_ids_from(
  'metadata_prefilter_plain',
  'off',
  '',
  $$tenant_hash = hashtextextended('feed-4', 0) AND state_code = 2$$
) = metadata_prefilter_ids_from(
  'metadata_prefilter_plain',
  'reject_only',
  '',
  $$tenant_hash = hashtextextended('feed-4', 0) AND state_code = 2$$
);
----
t

query B
SELECT metadata_prefilter_ids_from(
  'metadata_prefilter_items',
  'off',
  'tenant_hash,bogus,geo_token',
  $$tenant_hash = hashtextextended('feed-1', 0)
    AND geo_token = 6
    AND state_code = 0$$
) = metadata_prefilter_ids_from(
  'metadata_prefilter_items',
  'reject_only',
  'tenant_hash,bogus,geo_token',
  $$tenant_hash = hashtextextended('feed-1', 0)
    AND geo_token = 6
    AND state_code = 0$$
);
----
t

statement ok
SET vchordrq.metadata_prefilter_debug = on;

# debug=on must not change the result set (per-scan instrumentation only).
query B
SELECT metadata_prefilter_ids_from(
  'metadata_prefilter_items',
  'reject_only',
  'tenant_hash,state_code,deletion_marker',
  $$tenant_hash = hashtextextended('feed-3', 0)
    AND state_code = 2
    AND deletion_marker = 0$$
) = metadata_prefilter_ids_from(
  'metadata_prefilter_items',
  'off',
  'tenant_hash,state_code,deletion_marker',
  $$tenant_hash = hashtextextended('feed-3', 0)
    AND state_code = 2
    AND deletion_marker = 0$$
);
----
t

# debug=on with metadata_prefilter=off must still produce correct results.
# (The scanner allocates instrumentation, but metadata_candidate_allows
# short-circuits without checks.)
query B
SELECT metadata_prefilter_ids_from(
  'metadata_prefilter_items',
  'off',
  'tenant_hash,state_code,deletion_marker',
  $$tenant_hash = hashtextextended('feed-1', 0)
    AND state_code = 0$$
) = metadata_prefilter_ids_from(
  'metadata_prefilter_plain',
  'off',
  'tenant_hash,state_code,deletion_marker',
  $$tenant_hash = hashtextextended('feed-1', 0)
    AND state_code = 0$$
);
----
t

# debug=on with a predicate the prefilter can't cover (only non-meta columns)
# must not error and must match the off-mode result set.
query B
SELECT metadata_prefilter_ids_from(
  'metadata_prefilter_items',
  'reject_only',
  '',
  $$non_meta = 3$$
) = metadata_prefilter_ids_from(
  'metadata_prefilter_items',
  'off',
  '',
  $$non_meta = 3$$
);
----
t

# Toggling the GUC off then on within a session must work (the scanner
# re-reads the GUC on every rescan).
statement ok
SET vchordrq.metadata_prefilter_debug = off;

statement ok
SET vchordrq.metadata_prefilter_debug = on;

query B
SELECT metadata_prefilter_ids_from(
  'metadata_prefilter_items',
  'reject_only',
  '',
  $$tenant_hash = hashtextextended('feed-2', 0)
    AND state_code = 1
    AND deletion_marker = 0$$
) IS NOT NULL;
----
t

statement ok
SET vchordrq.metadata_prefilter_debug = off;

statement error
SHOW vchordrq.vector_read_window;

statement error
SHOW vchordrq.prefilter_window;

statement error
SHOW vchordrq.read_stream_batch;

statement error
SHOW vchordrq.instrument_timing;

statement ok
DROP FUNCTION metadata_prefilter_ids_from(regclass, text, text, text);

statement ok
DROP TABLE metadata_prefilter_items, metadata_prefilter_subset, metadata_prefilter_plain;
